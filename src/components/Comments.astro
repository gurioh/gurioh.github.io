---
// giscus comments, stored in this repo's GitHub Discussions (Announcements).
// Settings come from https://giscus.app for gurioh/gurioh.github.io.
---

<section class="mt-12" aria-label="댓글">
  <h2 class="mb-4 text-lg font-bold">댓글</h2>
  <div id="giscus-container" class="giscus"></div>
</section>

<script is:inline data-astro-rerun>
  (function () {
    const container = document.getElementById("giscus-container");
    if (!container || container.dataset.loaded) return;
    container.dataset.loaded = "true";

    const giscusTheme = () =>
      document.documentElement.getAttribute("data-theme") === "dark"
        ? "dark"
        : "light";

    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    script.async = true;
    script.crossOrigin = "anonymous";
    const attrs = {
      "data-repo": "gurioh/gurioh.github.io",
      "data-repo-id": "R_kgDOVoQ8zQ",
      "data-category": "Announcements",
      "data-category-id": "DIC_kwDOVoQ8zc4DK0gk",
      "data-mapping": "pathname",
      "data-strict": "1",
      "data-reactions-enabled": "1",
      "data-emit-metadata": "0",
      "data-input-position": "top",
      "data-theme": giscusTheme(),
      "data-lang": "ko",
      "data-loading": "lazy",
    };
    for (const [key, value] of Object.entries(attrs)) {
      script.setAttribute(key, value);
    }
    container.appendChild(script);

    // Follow the site's light/dark toggle.
    new MutationObserver(() => {
      const frame = document.querySelector("iframe.giscus-frame");
      frame?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: giscusTheme() } } },
        "https://giscus.app"
      );
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  })();
</script>
